<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>Blake Pell</Authors>
    <Company>Blake Pell</Company>
    <Description>nEdit Text Editor</Description>
    <AssemblyName>nedit</AssemblyName>
    <Copyright>2026</Copyright>
    <Version>2026.5.20.6</Version>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <CopyOutputSymbolsToPublishDirectory>true</CopyOutputSymbolsToPublishDirectory>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Syntax\*.nanorc" LogicalName="Nano.LocalSyntax.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>
</Project>
